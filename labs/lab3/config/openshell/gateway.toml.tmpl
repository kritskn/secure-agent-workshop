[openshell]
version = 2
[openshell.gateway]
name = @NAME@
bind_address = @BIND_ADDRESS@
compute_driver = "docker"
guest_tls_ca = "/state/tls/ca.crt"
guest_tls_cert = "/state/tls/client/tls.crt"
guest_tls_key = "/state/tls/client/tls.key"
[openshell.gateway.tls]
cert_path = "/state/tls/server/tls.crt"
key_path = "/state/tls/server/tls.key"
client_ca_path = "/state/tls/ca.crt"
[openshell.gateway.mtls_auth]
enabled = true
[openshell.gateway.gateway_jwt]
signing_key_path = "/state/tls/jwt/signing.pem"
public_key_path = "/state/tls/jwt/public.pem"
kid_path = "/state/tls/jwt/kid"
gateway_id = @NAME@
[openshell.drivers.docker]
socket_path = "/var/run/docker.sock"
image_pull_policy = "never"
sandbox_label = @NAME@
grpc_endpoint = @GATEWAY_ENDPOINT@
sandbox_runtime_image = @SANDBOX_IMAGE@
supervisor_image = @SUPERVISOR_IMAGE@
sandbox_pids_limit = 128
